NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GEMINI_API_KEY=your-server-side-gemini-key
GEMINI_MODEL=gemini-3.6-flash
# Optional direct-employer job feeds (comma-separated Greenhouse board tokens)
GREENHOUSE_BOARDS=postman,mongodb,cloudflare,stripe
# Gmail metadata integration. Use a separate Google OAuth web client.
GOOGLE_MAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_MAIL_CLIENT_SECRET=your-client-secret
MAILBOX_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
